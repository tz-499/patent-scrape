<invention-title id="d2e53">Transcranial focused ultrasound system for <i>targeted</i> neuromodulation</invention-title>
<us-parties>
<us-applicants><us-applicant sequence="001" app-type="applicant"><addressbook><orgname>Example Neuro Labs, Inc.</orgname></addressbook></us-applicant></us-applicants>
<inventors><inventor sequence="001"><addressbook><last-name>Rivera</last-name><first-name>Dana</first-name></addressbook></inventor></inventors>
</us-parties>
<assignees><assignee><addressbook><orgname>Example Neuro Labs, Inc.</orgname></addressbook></assignee></assignees>
</us-bibliographic-data-grant>
<abstract id="abstract"><p>A wearable array of ultrasound transducers delivers focused ultrasound
through the skull to modulate neural activity in a selected brain region, with
closed-loop adjustment based on measured brain signals.</p></abstract>
<claims id="claims">
<claim id="CLM-00001" num="00001"><claim-text>1. A system comprising a transducer array configured to deliver focused ultrasound to a target brain region and a controller that adjusts stimulation from sensed neural signals.</claim-text></claim>
<claim id="CLM-00002" num="00002"><claim-text>2. The system of claim 1, wherein the array is wearable.</claim-text></claim>
</claims>
</us-patent-grant>
